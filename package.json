{
  "name": "our-tomorrow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter our-tomorrow run \"/^dev:(api|web)$/\"",
    "dev:api": "pnpm --filter @our-tomorrow/api dev",
    "dev:web": "pnpm --filter @our-tomorrow/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:openapi": "pnpm --filter @our-tomorrow/api test:openapi",
    "test:e2e": "playwright test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @our-tomorrow/api prisma:generate",
    "db:migrate": "pnpm --filter @our-tomorrow/api prisma:migrate",
    "db:studio": "pnpm --filter @our-tomorrow/api prisma:studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
