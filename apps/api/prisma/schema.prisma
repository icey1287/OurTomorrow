generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum CoupleStatus {
  ACTIVE
  ARCHIVED
}

enum CoupleMemberStatus {
  ACTIVE
  LEFT
}

enum InviteCodeStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
  FILE
}

enum MediaStatus {
  PENDING
  READY
  QUARANTINED
  DELETED
}

enum MemoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MemoryMediaRole {
  COVER
  GALLERY
  ATTACHMENT
}

enum MemoryResurfaceReason {
  ON_THIS_DAY
  RANDOM
  FIRST_UPLOAD
  PLACE
  SEASON
  COMPLETE_PERSPECTIVES
}

enum AnnualReviewStatus {
  DRAFT
  GENERATING
  READY
  PUBLISHED
}

enum PlaceStatus {
  VISITED
  LIVED
  FIRST_TIME
  WANT_TO_GO
  PLANNED
  DEPARTING
  COMPLETED
}

enum ReactionTargetType {
  MEMORY
  COMMENT
  NOTE
}

enum CurrentStatusKind {
  BUSY
  COMMUTING
  RESTING
  TIRED
  HAPPY
  NEED_HUG
  TALK_LATER
  HOME
  MISS_YOU
  CUSTOM
}

enum CurrentStatusState {
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum NoteType {
  LOVE
  REMINDER
  THANKS
  APOLOGY
  TALK_LATER
  DO_TOGETHER
  SURPRISE
}

enum NoteStatus {
  DRAFT
  SCHEDULED
  VISIBLE
  VIEWED
  ARCHIVED
  EXPIRED
}

enum DailyPromptSource {
  SYSTEM
  CUSTOM
}

enum DailyEntryStatus {
  DRAFT
  EDITING
  SUBMITTED
  WAITING_FOR_PARTNER
  BOTH_SUBMITTED
  REVEALED
}

enum TouchEventKind {
  HUG
  MISS_YOU
  KISS
  CHEER
  REST
  TELL_ME_WHEN_HOME
  I_AM_HERE
}

enum DailyRitualStatus {
  PROPOSED
  SELECTED
  COMPLETED
  SKIPPED
}

enum CalmLetterPurpose {
  BE_HEARD
  DISCUSS_LATER
  SOLVE_TOGETHER
  NEED_SPACE
  READY_TO_OPEN
}

enum CalmLetterStatus {
  DRAFT
  LOCKED
  AVAILABLE
  OPENED
  ARCHIVED
}

enum WishCategory {
  TRAVEL
  FOOD
  LIFE
  LEARNING
  COMMEMORATION
  FAMILY
  PHOTOGRAPHY
  ADVENTURE
  CUSTOM
}

enum WishStatus {
  IDEA
  PLANNED
  IN_PROGRESS
  COMPLETED
  CONVERTED_TO_MEMORY
}

enum PlanStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AnniversaryType {
  RELATIONSHIP
  FIRST_MEETING
  BIRTHDAY
  MARRIAGE
  MOVING
  PET_BIRTHDAY
  CUSTOM
}

enum AnniversaryRepeat {
  NONE
  YEARLY
}

enum CapsuleType {
  TO_PARTNER
  TO_SELF
  TO_BOTH
  JOINT
  ANNIVERSARY
  EVENT
  FUTURE_LETTER
}

enum CapsuleUnlockRule {
  AT_TIME
  ANNIVERSARY
  WISH_COMPLETION
  MANUAL_CONDITION
}

enum CapsuleStatus {
  DRAFT
  SEALED
  LOCKED
  DUE
  UNLOCKED
  OPENED
  CONVERTED_TO_MEMORY
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ScheduledEventType {
  NOTE_SHOW
  NOTE_EXPIRE
  STATUS_EXPIRE
  CAPSULE_DUE
  ANNIVERSARY_REMINDER
  DAILY_PROMPT
  MEMORY_RESURFACE
  ANNUAL_REVIEW
  BACKUP_CHECK
  OUTBOX_RETRY
}

enum ScheduledEventStatus {
  PENDING
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ExportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

enum ExportFormat {
  JSON
  ZIP
}

model User {
  id                   String                     @id @default(uuid()) @db.Uuid
  username             String                     @unique @db.VarChar(64)
  displayName          String                     @map("display_name") @db.VarChar(100)
  avatarMediaId        String?                    @map("avatar_media_id") @db.Uuid
  passwordHash         String                     @map("password_hash") @db.VarChar(255)
  status               UserStatus                 @default(ACTIVE)
  version              Int                        @default(1)
  lastLoginAt          DateTime?                  @map("last_login_at") @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  avatarMedia          MediaAsset?                @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  coupleMembers        CoupleMember[]
  createdInvites       InviteCode[]               @relation("InviteCreatedBy")
  acceptedInvites      InviteCode[]               @relation("InviteAcceptedBy")
  sessions             Session[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  revisions            ContentRevision[]
  exportJobs           ExportJob[]
  idempotencyRecords   IdempotencyRecord[]
  createdMedia         MediaAsset[]               @relation("MediaCreatedBy")
  createdMemories      Memory[]                   @relation("MemoryCreatedBy")
  updatedMemories      Memory[]                   @relation("MemoryUpdatedBy")
  perspectives         MemoryPerspective[]
  comments             Comment[]
  reactions            Reaction[]
  createdPlaces        Place[]
  reviewContributions  AnnualReviewContribution[]
  currentStatuses      CurrentStatus[]
  authoredNotes        Note[]                     @relation("NoteAuthor")
  receivedNotes        Note[]                     @relation("NoteRecipient")
  createdPrompts       DailyPrompt[]
  dailyEntries         DailyEntry[]
  moodEntries          MoodEntry[]
  sentTouches          TouchEvent[]               @relation("TouchSender")
  receivedTouches      TouchEvent[]               @relation("TouchRecipient")
  chosenRituals        DailyRitual[]
  authoredLetters      CalmLetter[]               @relation("CalmLetterAuthor")
  receivedLetters      CalmLetter[]               @relation("CalmLetterRecipient")
  createdWishes        Wish[]
  wishUpdates          WishUpdate[]
  createdPlans         Plan[]
  createdAnniversaries Anniversary[]
  createdCapsules      Capsule[]
  capsuleMessages      CapsuleMessage[]
  capsuleOpenRecords   CapsuleOpenRecord[]

  @@index([status, deletedAt])
  @@map("users")
}

model Couple {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(120)
  startDate          DateTime            @map("start_date") @db.Date
  timezone           String              @default("Asia/Shanghai") @db.VarChar(64)
  signature          String?             @db.VarChar(280)
  coverMediaId       String?             @map("cover_media_id") @db.Uuid
  theme              String              @default("system") @db.VarChar(64)
  status             CoupleStatus        @default(ACTIVE)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  coverMedia         MediaAsset?         @relation("CoupleCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  members            CoupleMember[]
  inviteCodes        InviteCode[]
  sessions           Session[]
  notifications      Notification[]
  scheduledEvents    ScheduledEvent[]
  outboxEvents       OutboxEvent[]
  auditLogs          AuditLog[]
  revisions          ContentRevision[]
  exportJobs         ExportJob[]
  idempotencyRecords IdempotencyRecord[]
  mediaAssets        MediaAsset[]
  memories           Memory[]
  tags               Tag[]
  places             Place[]
  reactions          Reaction[]
  resurfaces         MemoryResurface[]
  annualReviews      AnnualReview[]
  currentStatuses    CurrentStatus[]
  notes              Note[]
  dailyPrompts       DailyPrompt[]
  dailyEntries       DailyEntry[]
  moodEntries        MoodEntry[]
  touchEvents        TouchEvent[]
  dailyRituals       DailyRitual[]
  calmLetters        CalmLetter[]
  wishes             Wish[]
  plans              Plan[]
  anniversaries      Anniversary[]
  capsules           Capsule[]

  @@index([status, deletedAt])
  @@map("couples")
}

model CoupleMember {
  id                     String             @id @default(uuid()) @db.Uuid
  coupleId               String             @map("couple_id") @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  slot                   Int
  nicknameInRelationship String?            @map("nickname_in_relationship") @db.VarChar(100)
  status                 CoupleMemberStatus @default(ACTIVE)
  joinedAt               DateTime           @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt                 DateTime?          @map("left_at") @db.Timestamptz(3)
  couple                 Couple             @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user                   User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([coupleId, userId])
  @@unique([coupleId, slot])
  @@index([coupleId, status])
  @@index([userId, status])
  @@map("couple_members")
}

model InviteCode {
  id           String           @id @default(uuid()) @db.Uuid
  coupleId     String           @map("couple_id") @db.Uuid
  codeHash     String           @unique @map("code_hash") @db.VarChar(255)
  status       InviteCodeStatus @default(ACTIVE)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?        @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdById  String           @map("created_by") @db.Uuid
  acceptedById String?          @map("accepted_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  couple       Couple           @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedBy   User?            @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([coupleId, status, expiresAt])
  @@map("invite_codes")
}

model Session {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  coupleId   String?       @map("couple_id") @db.Uuid
  tokenHash  String        @unique @map("token_hash") @db.VarChar(255)
  csrfHash   String        @map("csrf_hash") @db.VarChar(255)
  status     SessionStatus @default(ACTIVE)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime?     @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?       @map("ip_address") @db.Inet
  userAgent  String?       @map("user_agent") @db.VarChar(512)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  couple     Couple?       @relation(fields: [coupleId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  coupleId    String             @map("couple_id") @db.Uuid
  recipientId String             @map("recipient_id") @db.Uuid
  type        String             @db.VarChar(100)
  title       String             @db.VarChar(160)
  body        String             @db.VarChar(280)
  payload     Json               @default("{}")
  status      NotificationStatus @default(UNREAD)
  dedupeKey   String?            @unique @map("dedupe_key") @db.VarChar(180)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime?          @map("read_at") @db.Timestamptz(3)
  archivedAt  DateTime?          @map("archived_at") @db.Timestamptz(3)
  couple      Couple             @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  recipient   User               @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status, createdAt(sort: Desc)])
  @@index([coupleId, createdAt(sort: Desc)])
  @@map("notifications")
}

model ScheduledEvent {
  id          String               @id @default(uuid()) @db.Uuid
  coupleId    String?              @map("couple_id") @db.Uuid
  type        ScheduledEventType
  payload     Json                 @default("{}")
  runAt       DateTime             @map("run_at") @db.Timestamptz(3)
  status      ScheduledEventStatus @default(PENDING)
  attempts    Int                  @default(0)
  maxAttempts Int                  @default(5) @map("max_attempts")
  lockedAt    DateTime?            @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?              @map("locked_by") @db.VarChar(120)
  lastError   String?              @map("last_error") @db.Text
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?            @map("completed_at") @db.Timestamptz(3)
  couple      Couple?              @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([coupleId, status, runAt])
  @@map("scheduled_events")
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  coupleId      String?           @map("couple_id") @db.Uuid
  aggregateType String            @map("aggregate_type") @db.VarChar(80)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(120)
  payload       Json              @default("{}")
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(3)
  lastError     String?           @map("last_error") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  couple        Couple?           @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  coupleId     String?  @map("couple_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String?  @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.Uuid
  requestId    String?  @map("request_id") @db.VarChar(128)
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  couple       Couple?  @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([coupleId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model ContentRevision {
  id           String   @id @default(uuid()) @db.Uuid
  coupleId     String   @map("couple_id") @db.Uuid
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String   @map("resource_id") @db.Uuid
  version      Int
  authorId     String   @map("author_id") @db.Uuid
  changes      Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  couple       Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  author       User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([resourceType, resourceId, version])
  @@index([coupleId, createdAt(sort: Desc)])
  @@map("content_revisions")
}

model ExportJob {
  id            String          @id @default(uuid()) @db.Uuid
  coupleId      String          @map("couple_id") @db.Uuid
  requestedById String          @map("requested_by") @db.Uuid
  status        ExportJobStatus @default(PENDING)
  format        ExportFormat    @default(ZIP)
  storageKey    String?         @map("storage_key") @db.VarChar(512)
  checksum      String?         @db.VarChar(128)
  startedAt     DateTime?       @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(3)
  expiresAt     DateTime?       @map("expires_at") @db.Timestamptz(3)
  lastError     String?         @map("last_error") @db.Text
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  couple        Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  requestedBy   User            @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([coupleId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("export_jobs")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  coupleId       String?  @map("couple_id") @db.Uuid
  route          String   @db.VarChar(180)
  keyHash        String   @map("key_hash") @db.VarChar(64)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couple         Couple?  @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([userId, route, keyHash])
  @@index([expiresAt])
  @@index([coupleId, createdAt(sort: Desc)])
  @@map("idempotency_records")
}

model MediaAsset {
  id                     String                     @id @default(uuid()) @db.Uuid
  coupleId               String                     @map("couple_id") @db.Uuid
  storageKey             String                     @unique @map("storage_key") @db.VarChar(512)
  originalName           String                     @map("original_name") @db.VarChar(255)
  mimeType               String                     @map("mime_type") @db.VarChar(120)
  kind                   MediaKind                  @default(IMAGE)
  status                 MediaStatus                @default(PENDING)
  size                   BigInt
  width                  Int?
  height                 Int?
  duration               Int?
  thumbnailKey           String?                    @map("thumbnail_key") @db.VarChar(512)
  checksumSha256         String?                    @map("checksum_sha256") @db.VarChar(64)
  createdById            String                     @map("created_by") @db.Uuid
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt              DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  couple                 Couple                     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy              User                       @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  usedAsUserAvatar       User[]                     @relation("UserAvatar")
  usedAsCoupleCover      Couple[]                   @relation("CoupleCover")
  usedAsMemoryCover      Memory[]                   @relation("MemoryCover")
  usedAsAnniversaryCover Anniversary[]              @relation("AnniversaryCover")
  memoryMedia            MemoryMedia[]
  capsuleMedia           CapsuleMedia[]
  reviewContributions    AnnualReviewContribution[]

  @@index([coupleId, status, createdAt(sort: Desc)])
  @@index([coupleId, deletedAt])
  @@map("media_assets")
}

model Place {
  id             String      @id @default(uuid()) @db.Uuid
  coupleId       String      @map("couple_id") @db.Uuid
  name           String      @db.VarChar(160)
  address        String?     @db.VarChar(300)
  latitude       Decimal?    @db.Decimal(9, 6)
  longitude      Decimal?    @db.Decimal(9, 6)
  status         PlaceStatus @default(VISITED)
  version        Int         @default(1)
  firstVisitedAt DateTime?   @map("first_visited_at") @db.Timestamptz(3)
  createdById    String      @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  couple         Couple      @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy      User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  memories       Memory[]
  wishes         Wish[]
  plans          Plan[]

  @@index([coupleId, status, deletedAt])
  @@index([coupleId, name])
  @@map("places")
}

model Memory {
  id                  String              @id @default(uuid()) @db.Uuid
  coupleId            String              @map("couple_id") @db.Uuid
  title               String              @db.VarChar(200)
  content             String?             @db.Text
  happenedAt          DateTime            @map("happened_at") @db.Timestamptz(3)
  placeId             String?             @map("place_id") @db.Uuid
  coverMediaId        String?             @map("cover_media_id") @db.Uuid
  mood                String?             @db.VarChar(80)
  isFirstTime         Boolean             @default(false) @map("is_first_time")
  firstTimeLabel      String?             @map("first_time_label") @db.VarChar(160)
  isPinned            Boolean             @default(false) @map("is_pinned")
  status              MemoryStatus        @default(PUBLISHED)
  version             Int                 @default(1)
  sourceWishId        String?             @unique @map("source_wish_id") @db.Uuid
  sourceCapsuleId     String?             @unique @map("source_capsule_id") @db.Uuid
  sourceNoteId        String?             @unique @map("source_note_id") @db.Uuid
  sourceAnniversaryId String?             @map("source_anniversary_id") @db.Uuid
  createdById         String              @map("created_by") @db.Uuid
  updatedById         String?             @map("updated_by") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(3)
  couple              Couple              @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  place               Place?              @relation(fields: [placeId], references: [id], onDelete: SetNull)
  coverMedia          MediaAsset?         @relation("MemoryCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  sourceWish          Wish?               @relation("WishConvertedMemory", fields: [sourceWishId], references: [id], onDelete: SetNull)
  sourceCapsule       Capsule?            @relation("CapsuleConvertedMemory", fields: [sourceCapsuleId], references: [id], onDelete: SetNull)
  sourceNote          Note?               @relation("NoteConvertedMemory", fields: [sourceNoteId], references: [id], onDelete: SetNull)
  sourceAnniversary   Anniversary?        @relation("AnniversaryMemories", fields: [sourceAnniversaryId], references: [id], onDelete: SetNull)
  createdBy           User                @relation("MemoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           User?               @relation("MemoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  perspectives        MemoryPerspective[]
  media               MemoryMedia[]
  tags                MemoryTag[]
  comments            Comment[]
  resurfaces          MemoryResurface[]

