generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid()) @db.Uuid
  username         String          @unique @db.VarChar(64)
  displayName      String          @map("display_name") @db.VarChar(100)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  coupleMembership CoupleMember?
  currentStatuses  CurrentStatus[]
  authoredNotes    Note[]          @relation("NoteAuthor")
  receivedNotes    Note[]          @relation("NoteRecipient")

  @@map("users")
}

model Couple {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(120)
  startDate       DateTime        @map("start_date") @db.Date
  timezone        String          @default("Asia/Shanghai") @db.VarChar(64)
  signature       String?         @db.VarChar(280)
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  members         CoupleMember[]
  currentStatuses CurrentStatus[]
  notes           Note[]

  @@map("couples")
}

model CoupleMember {
  id       String   @id @default(uuid()) @db.Uuid
  coupleId String   @map("couple_id") @db.Uuid
  userId   String   @unique @map("user_id") @db.Uuid
  slot     Int
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  couple   Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coupleId, slot])
  @@index([coupleId])
  @@map("couple_members")
}

model CurrentStatus {
  id              String    @id @default(uuid()) @db.Uuid
  coupleId        String    @map("couple_id") @db.Uuid
  authorId        String    @map("author_id") @db.Uuid
  kind            String    @db.VarChar(32)
  version         Int       @default(1)
  message         String?   @db.VarChar(280)
  location        String?   @db.VarChar(160)
  locationAddress String?   @map("location_address") @db.VarChar(300)
  latitude        Decimal?  @db.Decimal(9, 6)
  longitude       Decimal?  @db.Decimal(9, 6)
  startsAt        DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  couple          Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([coupleId, authorId, archivedAt, expiresAt])
  @@map("current_statuses")
}

model Note {
  id          String    @id @default(uuid()) @db.Uuid
  coupleId    String    @map("couple_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  version     Int       @default(1)
  content     String    @db.Text
  icon        String?   @db.VarChar(32)
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  couple      Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  author      User      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient   User      @relation("NoteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([coupleId, createdAt(sort: Desc)])
  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@map("notes")
}
