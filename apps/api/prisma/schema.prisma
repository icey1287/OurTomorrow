  createdBy                User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  messages                 CapsuleMessage[]
  media                    CapsuleMedia[]
  openRecords              CapsuleOpenRecord[]
  convertedMemory          Memory?             @relation("CapsuleConvertedMemory")

  @@index([coupleId, status, unlockAt])
  @@index([anniversaryId])
  @@index([wishId])
  @@index([coupleId, deletedAt])
  @@map("capsules")
}

model CapsuleMessage {
  id        String   @id @default(uuid()) @db.Uuid
  capsuleId String   @map("capsule_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String   @db.Text
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  capsule   Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([capsuleId, authorId])
  @@map("capsule_messages")
}

model CapsuleMedia {
  capsuleId    String     @map("capsule_id") @db.Uuid
  mediaAssetId String     @map("media_asset_id") @db.Uuid
  sortOrder    Int        @default(0) @map("sort_order")
  capsule      Capsule    @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([capsuleId, mediaAssetId])
  @@index([capsuleId, sortOrder])
  @@map("capsule_media")
}

model CapsuleOpenRecord {
  id          String    @id @default(uuid()) @db.Uuid
  capsuleId   String    @map("capsule_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  openedAt    DateTime? @map("opened_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  capsule     Capsule   @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([capsuleId, userId])
  @@index([userId, openedAt])
  @@map("capsule_open_records")
}
