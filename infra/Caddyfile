{
	admin off
}

{$APP_SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; font-src 'self' data:; manifest-src 'self'; worker-src 'self' blob:"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:3000
	}

	@socket path /socket/*
	handle @socket {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:8080
	}
}
