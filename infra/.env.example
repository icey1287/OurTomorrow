# Copy to infra/.env for Docker Compose. Never commit real secrets.
# Production must stay reachable only through one explicit private interface/VPN
# address, or through a device-gated upstream proxy bound to loopback here.
ACCESS_BOUNDARY=upstream-access-proxy
PRIVATE_ACCESS_ACKNOWLEDGED=false
CADDY_BIND_ADDRESS=127.0.0.1

# With an upstream TLS proxy, Caddy can listen on localhost HTTP while the public
# URL remains HTTPS. For direct private-interface access, use an https:// Caddy
# site address and bind CADDY_BIND_ADDRESS to that private/VPN interface IP.
APP_SITE_ADDRESS=:80
NODE_ENV=production
PUBLIC_APP_URL=https://our-tomorrow.private.example
WEB_ORIGIN=https://our-tomorrow.private.example
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=2026.07.17-commit-sha
DEPLOY_IMAGE_MODE=build
DEPLOY_HEALTH_TIMEOUT_SECONDS=300
DEPLOY_RECORD_DIR=infra/releases

POSTGRES_DB=our_tomorrow
POSTGRES_USER=our_tomorrow
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://our_tomorrow:replace-with-a-url-encoded-password@postgres:5432/our_tomorrow?schema=public
BACKUP_DATABASE_URL=postgresql://our_tomorrow:replace-with-a-url-encoded-password@postgres:5432/our_tomorrow

MEDIA_MAX_BYTES=15728640
MEDIA_MAX_PIXELS=40000000
MEDIA_UPLOAD_TTL_SECONDS=900
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_MAX_AGE_SECONDS=60

# Restic encrypts every backup. Point this at a remote repository in production.
RESTIC_REPOSITORY=s3:s3.example.invalid/our-tomorrow-backups
# Keep the default named volume for development. A local recovery drill may set
# this to an isolated absolute host path; production still requires an off-host
# repository or independently monitored off-host copy.
BACKUP_REPOSITORY_SOURCE=backup_data
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-backup-password
BACKUP_OFFSITE_ACKNOWLEDGED=false
BACKUP_HOST_LABEL=our-tomorrow-production
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
BACKUP_MAX_AGE_SECONDS=129600
# Every successful backup checks repository metadata/index integrity before it is
# marked healthy. Set a rotating data subset such as 5% only after measuring cost.
RESTIC_CHECK_REPOSITORY=true
RESTIC_CHECK_READ_DATA_SUBSET=

# Only required for an S3-compatible Restic repository.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

TZ=Asia/Shanghai
